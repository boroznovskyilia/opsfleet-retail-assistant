# Copy to .env and fill locally. Never paste keys into chat or commit .env.
OPENROUTER_API_KEY=
# Pinned Gemini model; see recorded live checks and rerun doctor when capabilities change.
OPENROUTER_MODEL=google/gemini-3.8-flash
# Owner-authorized cumulative development/evaluation budget; not per conversation.
# The app reserves cumulative cost; also set the key's non-resetting provider credit cap.
OPENROUTER_BUDGET_USD=5
# Your own Google Cloud Sandbox project, not bigquery-public-data.
GOOGLE_CLOUD_PROJECT=
# BigQuery authentication uses local ADC from gcloud, not an API key in this file.
